post_install() {
  echo "==> inno installed successfully!"
  echo ""
  echo "==> Copy config to ~/.config/inno/ and customize:"
  echo "    mkdir -p ~/.config/inno"
  echo "    cp /etc/xdg/inno/inno.toml ~/.config/inno/"
  echo "    cp -r /etc/xdg/inno/events/ ~/.config/inno/"
  echo ""
  echo "==> Start with compositor autostart or systemd:"
  echo "    Hyprland:  exec-once = inno --internal-daemon"
  echo "    Sway:      exec inno --internal-daemon"
  echo "    River:     riverctl spawn inno --internal-daemon"
  echo "    systemd:   systemctl --user enable --now inno.service"
}

post_upgrade() {
  echo "==> inno upgraded to $2"
  echo "==> Check /etc/xdg/inno/ for new config options"
  echo "==> Compare with your ~/.config/inno/ and merge changes"
}
